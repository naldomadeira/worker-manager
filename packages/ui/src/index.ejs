<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="robots" content="noindex" />
    <base href="<%= basePath %>" />
    <title><%= title %></title>
    <link rel="alternate icon" type="image/png" href="<%= favIconAlternative %>">
    <link rel="icon" type="image/svg+xml" id="fav-logo" href="<%= favIconDefault %>">
    <script>
      // Resolve the colour scheme before first paint so the board never flashes the wrong theme.
      (function () {
        try {
          var stored = JSON.parse(localStorage.getItem('board-settings') || '{}');
          var pref = (stored.state && stored.state.theme) || 'system';
          var dark = pref === 'dark' || (pref === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        } catch (e) {}
      })();
    </script>
</head>
<body class="preload">
<script id="__UI_CONFIG__" type="application/json"><%= uiConfig %></script>
<div id="root">
  <div class="wm-splash">
    <span class="wm-splash-mark"></span>
    <span>Loading</span>
  </div>
  <style>
    .wm-splash{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;gap:1rem;font-family:system-ui,sans-serif;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;background:#f8fafc;color:#64748b}
    .dark .wm-splash{background:#0f141c;color:#8a94a6}
    .wm-splash-mark{width:2.25rem;height:2.25rem;border-radius:.75rem;background:linear-gradient(135deg,#3b82f6,#6366f1);animation:wm-breathe 1.4s ease-in-out infinite}
    @keyframes wm-breathe{0%,100%{transform:scale(.85);opacity:.55}50%{transform:scale(1);opacity:1}}
  </style>
</div>
</body>
</html>
