{
  "compilerOptions": {
    "outDir": "dist",
    "esModuleInterop": true,
    "lib": ["es2022"],
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "./src",
    "noImplicitAny": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "declaration": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["./src"]
}
