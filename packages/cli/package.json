{
  "name": "@worker-manager/cli",
  "version": "1.0.0",
  "description": "Run the Worker Manager dashboard against Redis or PostgreSQL (BullMQ v6) from the command line.",
  "keywords": [
    "bull",
    "bull-board",
    "bullmq",
    "cli",
    "dashboard",
    "jobs",
    "monitoring",
    "queue",
    "queue-dashboard",
    "redis",
    "standalone"
  ],
  "license": "MIT",
  "author": "naldomadeira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naldomadeira/worker-manager.git",
    "directory": "packages/cli"
  },
  "bin": {
    "bull-board": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "yarn clean && tsc && chmod +x dist/bin.js",
    "clean": "rm -rf dist",
    "test": "jest"
  },
  "dependencies": {
    "@worker-manager/api": "1.0.0",
    "@worker-manager/auth": "1.0.0",
    "@worker-manager/express": "1.0.0",
    "@worker-manager/metrics": "1.0.0",
    "bull": "^4.16.5",
    "bullmq": "^5.81.3",
    "bullmq-v6": "npm:bullmq@^6",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.23.1",
    "@types/redis-parser": "^3.0.3",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "redis-parser": "^3.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
