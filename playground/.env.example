# Port the playground app listens on. Keycloak's client only allows redirects to :3100.
PORT=3100

# none | basic | keycloak
WM_AUTH=basic

# Basic auth credentials (WM_AUTH=basic)
WM_BASIC_USER=admin
WM_BASIC_PASSWORD=admin

# Keycloak (WM_AUTH=keycloak) - matches playground/keycloak/worker-manager-realm.json
KEYCLOAK_URL=http://localhost:8090
KEYCLOAK_REALM=worker-manager
KEYCLOAK_CLIENT_ID=worker-manager-board
KEYCLOAK_CLIENT_SECRET=playground-secret
KEYCLOAK_REQUIRED_ROLES=wm-admin
WM_COOKIE_SECRET=change-me-to-a-long-random-string-please

# Datastores
REDIS_URL=redis://localhost:6390
# Leave empty to skip the PostgreSQL-backed queues
POSTGRES_URL=postgres://bullmq:bullmq@localhost:5440/bullmq

# Generate synthetic traffic (jobs every few hundred ms, random failures, flows, schedulers)
WM_TRAFFIC=true
